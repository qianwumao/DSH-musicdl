<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:centerColor="@color/glass_center"
                android:endColor="@color/glass_top"
                android:startColor="@color/glass_bottom" />
            <corners android:radius="16dp" />
            <stroke android:width="1dp" android:color="@color/glass_stroke" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:centerX="0.22"
                android:centerY="0.0"
                android:endColor="@color/transparent"
                android:gradientRadius="180dp"
                android:startColor="@color/glass_glow"
                android:type="radial" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item
        android:height="1dp"
        android:left="20dp"
        android:right="20dp"
        android:top="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:centerColor="@color/glass_rim"
                android:endColor="@color/transparent"
                android:startColor="@color/transparent" />
            <corners android:radius="1dp" />
        </shape>
    </item>
</layer-list>
